{
  "name": "synapsis",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:dev": "dotenv -e .env.dev -- next dev --turbopack -p 3050",
    "build": "next build",
    "start": "npm run db:migrate && next start --hostname 127.0.0.1",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:generate:dev": "dotenv -e .env.dev -- drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:push:dev": "dotenv -e .env.dev -- drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:studio:dev": "dotenv -e .env.dev -- drizzle-kit studio",
    "type-check": "tsc --noEmit",
    "test": "vitest run --dir src && vitest run --dir services && npm test --workspace @gnosyslabs/synapsis-cli",
    "test:watch": "vitest",
    "push-relay:start": "tsx services/push-relay/src/server.ts",
    "push-relay:test": "vitest run services/push-relay/src",
    "cli:test": "npm test --workspace @gnosyslabs/synapsis-cli",
    "cli:pack": "npm pack --workspace @gnosyslabs/synapsis-cli"
  },
  "dependencies": {
    "@tursodatabase/database": "0.7.0",
    "@upstash/redis": "^1.34.3",
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.2.3",
    "drizzle-orm": "1.0.0-rc.4",
    "jose": "^6.0.11",
    "libsodium-wrappers-sumo": "^0.8.2",
    "lucide-react": "^0.562.0",
    "multiformats": "^13.4.2",
    "music-metadata": "^11.14.0",
    "next": "16.1.4",
    "next-auth": "^5.0.0-beta.25",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tldts": "^7.4.8",
    "uuid": "^11.1.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.30",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "fast-check": "^4.5.3",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
