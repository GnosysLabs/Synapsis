# Synapsis local development environment
# Copy to .env and adjust values for your machine.

# Required: local database
# Embedded Turso database file. Relative paths resolve from the app directory.
DATABASE_PATH=./data/synapsis.db

# Synapsis' standard local bind port. Override it if this port is already in use.
PORT=43821

# Required: used for sessions and node key encryption
AUTH_SECRET=replace-with-a-long-random-secret
E2EE_RECOVERY_SECRET=replace-with-a-separate-long-random-secret

# Required for admin access. Register with one of these emails locally.
ADMIN_EMAILS=admin@example.com

# Recommended: local node identity
NEXT_PUBLIC_NODE_DOMAIN=localhost:43821
NEXT_PUBLIC_APP_URL=http://localhost:43821

# Recommended: Stuffbox instance offered as the default user-owned media provider.
# Synapsis registers its callback automatically; no Stuffbox client ID is required.
STUFFBOX_URL=https://stuffbox.xyz

# Optional: exact additional HTTPS origins whose media may be rendered from
# federated payloads. This is an origin allowlist, not a peer-node allowlist.
# NEXT_PUBLIC_FEDERATION_MEDIA_ORIGINS=https://media.example.com,https://cdn.example.com

# Optional: node metadata shown before a node record exists in the database
# NEXT_PUBLIC_NODE_NAME=Synapsis Local
# NEXT_PUBLIC_NODE_DESCRIPTION=Local development node
# NEXT_PUBLIC_ACCENT_COLOR=#FFFFFF

# Native iOS release destinations shown after iPhone registration. The official
# App Store listing is built in; set the URL only to override it for a fork.
# The app URL may be a Synapsis deep link or an HTTPS universal link.
# NEXT_PUBLIC_IOS_APP_URL=synapsis://
# NEXT_PUBLIC_IOS_APP_STORE_URL=https://apps.apple.com/us/app/synapsis-social/id6792197034

# Central relay used automatically by the built-in native push delivery outbox.
# Operators normally leave this at the protocol default.
PUSH_RELAY_URL=https://push.synapsis.social
