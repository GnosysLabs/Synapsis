[Unit]
Description=Synapsis node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=synapsis
Group=synapsis
WorkingDirectory=/opt/synapsis-current
EnvironmentFile=/etc/synapsis.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/env npm run start:server
Restart=on-failure
RestartSec=5
TimeoutStartSec=90
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/synapsis /opt/synapsis-current/.next

[Install]
WantedBy=multi-user.target
